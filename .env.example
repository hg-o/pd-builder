# Vercel 프로젝트 → Settings → Environment Variables 에 같은 이름으로 등록하세요 (Production/Preview 모두).
# 로컬에서 `vercel dev` 로 돌릴 때는 이 파일을 .env 로 복사해 값을 채웁니다. (.env 는 git 에 올라가지 않습니다)

# Upstash 콘솔 → 데이터베이스 → REST API 탭 (Vercel Marketplace 로 연결하면 자동 등록됩니다)
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx...

# Apps Script ↔ Vercel 동기화용 공유 비밀값. 32자 이상 임의 문자열.
# Apps Script 의 스크립트 속성 SYNC_SECRET 에도 똑같은 값을 넣어야 합니다.
SYNC_SECRET=change-me-to-a-long-random-string

# true 로 바꾸면 새 가입자의 비밀번호를 SHA-256 해시로 저장합니다. (로그인은 평문/해시 모두 허용)
HASH_PASSWORDS=false

# 첨부 파일(IP 데이터 분석 결과지) 저장용 Apps Script 웹 앱 URL. 배포 → 웹 앱 → URL (…/exec)
# 파일은 이 웹 앱이 회사 계정으로 Google Drive 폴더(Code.gs 의 DRIVE_FOLDER_ID)에 저장합니다. 인증에는 SYNC_SECRET 을 함께 씁니다.
APPS_SCRIPT_FILES_URL=https://script.google.com/macros/s/xxxxx/exec
