# Vercel 프로젝트 설정 → Settings → Environment Variables 에 같은 이름으로 등록하세요.
# 로컬에서 `vercel dev` 로 돌릴 때는 이 파일을 .env 로 복사해 값을 채웁니다. (.env 는 git 에 올라가지 않습니다)

# 서비스 계정 이메일 (Google Cloud → IAM 및 관리자 → 서비스 계정)
GOOGLE_SERVICE_ACCOUNT_EMAIL=byus-builder@your-project.iam.gserviceaccount.com

# 서비스 계정 키 JSON 의 "private_key" 값을 그대로 붙여 넣습니다. (-----BEGIN PRIVATE KEY----- ... 줄바꿈은 \n 으로 두어도 됩니다)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# 사용자 시트. 기본값은 'byUs PD 자동화 ID' 스프레드시트입니다.
SHEET_ID=1bkeTv7isOVdy3TDpa7kkM2L2GDhJO73NaLdKwvXlw64
SHEET_NAME=시트1

# true 로 바꾸면 비밀번호를 SHA-256 해시로 저장/비교합니다. (기존 평문 행은 다시 등록해야 함)
HASH_PASSWORDS=false
